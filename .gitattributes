# Normalize line endings on checkin, use LF in the repo, expand to native
# on checkout. Prevents CRLF/LF warning noise on Windows and keeps the tree
# portable if it ever lands on a Linux CI runner.
* text=auto eol=lf

# Windows-only scripts must stay CRLF or cmd.exe/PowerShell chokes.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries — never touch.
*.dll binary
*.lib binary
*.a   binary
*.so  binary
*.exe binary
*.pdb binary
*.pdf binary
*.png binary
*.jpg binary
